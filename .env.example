# Copy this file to .env before running the project.
POSTGRES_DB=developers_performance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/developers_performance?schema=public
JWT_SECRET=replace-this-with-a-long-random-secret
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api
SEED_ADMIN_EMAIL=muaaz@techdots.dev
SEED_ADMIN_PASSWORD=Admin@123

# Discord daily-status ingestion. Never commit the real bot token.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_STATUS_CHANNEL_ID=

# Read-only ClickUp task details and comments.
CLICKUP_API_TOKEN=
